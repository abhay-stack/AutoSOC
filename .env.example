# Copy this file to .env. Never commit .env or paste credentials into logs.
# AutoSOC runs safely without either key and labels all fallback data as mocked.

# Optional: enables live reputation checks for globally routable source IPs.
ABUSEIPDB_API_KEY=

# Optional: enables validated ChatOpenAI selections inside the LangGraph workflow.
OPENAI_API_KEY=

# Optional model override. The default is intentionally inexpensive.
AUTOSOC_OPENAI_MODEL=gpt-5-nano

# Optional comma-separated exact hostnames for custom web domains. Render's
# generated onrender.com hostname is trusted automatically.
AUTOSOC_ALLOWED_HOSTS=

# Web requests remain offline even when provider keys exist. Enabling live web
# calls also requires AUTOSOC_WEB_PASSWORD to be set to at least 16 characters.
AUTOSOC_ENABLE_LIVE_PROVIDERS=false

# Optional HTTP Basic authentication for the dashboard. The health endpoint is
# intentionally exempt so the hosting platform can perform readiness checks.
AUTOSOC_WEB_USERNAME=autosoc
AUTOSOC_WEB_PASSWORD=

# Global per-process POST budget. Zero disables it for local development;
# render.yaml sets a conservative public-demo limit.
AUTOSOC_RATE_LIMIT_PER_MINUTE=0
